# ---------------------------------------------------------------------
# 方案 C：家庭宽带 + 路由器端口转发（浏览器 → 路由器:443 → Nginx:9443）
#
#   浏览器 ──https:443──► 家用路由器(端口转发) ──9443──► Nginx ──► 游戏
#
# 关键点：
#   - TLS 在 Nginx 终止：路由器只做纯 TCP 转发，不解密 HTTPS
#   - 浏览器只看到外部 443（https 默认端口），游戏客户端会自动生成
#     wss://域名/dorm-brawl/ws，无需任何改动
#   - absolute_redirect off：必须！否则 Nginx 会把内部端口 9443 写进
#     301 跳转（Location: https://域名:9443/...），外网无法访问
#
# ⚠️ 复制本块时，请同时复制文件顶部的 map 块（在 server 块外面）
# ⚠️ 若该域名已有正在使用的 server 块（同 listen + server_name），
#    请把 location 合并进【已有的那个块】，不要新建 server 块
# ---------------------------------------------------------------------
server {
    listen 9443 ssl;
    server_name home.example.com;        # ← 你的域名（DDNS 域名也可以）

    ssl_certificate     /etc/letsencrypt/live/home.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/home.example.com/privkey.pem;

    absolute_redirect off;               # ← 端口转发场景的关键

    # 不带尾斜杠时跳转（absolute_redirect off 后这是相对跳转，安全）
    location = /dorm-brawl {
        return 301 /dorm-brawl/;
    }

    location /dorm-brawl/ {
        proxy_pass http://127.0.0.1:8080/;

        # --- WebSocket 必需 ---
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # --- 传递真实客户端信息 ---
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 游戏是长连接，调大超时（服务器自带 30s 心跳，双保险）
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# ---------------------------------------------------------------------
# HTTPS 证书申请（方案 C 注意事项）
# ---------------------------------------------------------------------
# certbot 的 HTTP-01 验证要求外网 80 端口能到达 Nginx。两种做法：
#
# 做法 1：路由器再转发一条 80 → Nginx 所在机器的 80，Nginx 里加一个
#         listen 80 的 server 块（可以只用于验证），然后：
#             sudo certbot --nginx -d home.example.com
#
# 做法 2：外网 80 被运营商封了 → 用 DNS-01 验证（不需要 80 端口）：
#             sudo certbot certonly --manual --preferred-challenges dns \
#                  -d home.example.com
#         （按提示去 DNS 服务商加 TXT 记录；可换对应 DNS 插件免手动）
#
# 其他家庭宽带常见坑：
#   - NAT 回流（hairpin）：部分家用路由器不支持，导致你在自家 WiFi 下
#     用域名访问不通，但外网（手机流量）完全正常。测试请用手机流量。
#   - CGNAT（运营商大内网）：若 WAN 口拿到的是 10/100/172 开头的内网 IP，
#     端口转发不会生效，需改用 frp / Cloudflare Tunnel 等内网穿透。
#   - 外部端口不是 443 也能玩：比如路由器 8443→9443，访问
#     https://域名:8443/dorm-brawl/ 即可，客户端会自动带上端口。
# ---------------------------------------------------------------------
