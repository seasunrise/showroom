# =====================================================================
# 宿舍大乱斗 — Nginx 反向代理配置示例
#
# 用法：把下面【map 块】和你选中的【某个 server 块】一起复制到
#       /etc/nginx/conf.d/dorm-brawl.conf（或 sites-available），
#       修改 server_name / 证书路径后 `nginx -t && nginx -s reload`。
#
# ⚠️ 两部分缺一不可：
#   - map 块：定义 $connection_upgrade 变量，必须在 server 块【外面】
#     （漏掉它会报错：unknown "connection_upgrade" variable）
#   - server 块：三选一（方案 A / B / C）
#
# 前提：游戏服务器已在运行，例如
#       HOST=127.0.0.1 PORT=8080 python server.py
#       （只监听 127.0.0.1 时，外部只能经由 Nginx 访问，更安全）
#
# WebSocket 反代三要素（下面配置已包含）：
#   1. proxy_http_version 1.1
#   2. proxy_set_header Upgrade $http_upgrade
#   3. proxy_set_header Connection $connection_upgrade   ← 依赖 map 块
# =====================================================================

# 【必复制】把 Upgrade 头映射成 Connection 头
# 位置要求：在 http 上下文、所有 server 块之外；放在本文件顶部即可
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ---------------------------------------------------------------------
# 方案 A：子路径部署  →  https://example.com/dorm-brawl/
# 适合一台服务器挂多个站点/游戏的场景
# 游戏页面会自动把 WebSocket 连接到 wss://example.com/dorm-brawl/ws
#
# 路径可自定义（如 /demo/dorm-brawl/ 这样的多级路径）：
#   同步修改下面两处 location 的路径即可，proxy_pass 保持不变
#   （结尾的 / 会自动剥掉 location 匹配到的前缀）
#
# ⚠️ 若该域名已有正在使用的 server 块（同 listen + server_name），
#    请把这两个 location 合并进【已有的那个块】，不要新建 server 块，
#    否则后加载的块会被 nginx 忽略（conflicting server name）
# ---------------------------------------------------------------------
server {
    listen 80;
    server_name example.com;          # ← 改成你的域名或 _

    # 不带尾斜杠时跳转一下，保证相对路径正确
    location = /dorm-brawl {
        return 301 /dorm-brawl/;
    }

    location /dorm-brawl/ {
        # 结尾的 / 会把 /dorm-brawl/ 前缀剥掉再转发给游戏服务器
        proxy_pass http://127.0.0.1:8080/;

        # --- WebSocket 必需 ---
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # --- 传递真实客户端信息 ---
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 游戏是长连接，调大超时（服务器自带 30s 心跳，双保险）
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

